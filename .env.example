# Context.dev — server-side secret. Copy this file to `.env` and paste your key.
# The SDK reads CONTEXT_DEV_API_KEY from the environment automatically.
# Rotate keys at https://www.context.dev/dashboard/api-keys
CONTEXT_DEV_API_KEY=ctxt_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional overrides (safe defaults are used when unset) ---
# Override the API base URL (default: https://api.context.dev/v1)
# CONTEXT_DEV_BASE_URL=https://api.context.dev/v1
# Max automatic retries for 408/409/429/5xx (default: 2). Validation errors are never retried.
# CONTEXT_DEV_MAX_RETRIES=2
# Per-request timeout in milliseconds (default: 60000)
# CONTEXT_DEV_TIMEOUT_MS=60000
# Default cache TTL (ms) applied to cacheable reads when a call does not pass its own.
# Leave unset to use each endpoint's own default. Set 0 to always fetch fresh.
# CONTEXT_DEV_DEFAULT_MAX_AGE_MS=
