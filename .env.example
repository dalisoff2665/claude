# Скопируй в .env, заполни, и обязательно: chmod 600 .env
# .env в .gitignore. Значения никогда не коммитить и не вставлять в чат.

# --- Cloudinary (publish.py) ---
# Отдельный ключ под reels-пайплайн, НЕ тот же что в n8n.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Green API (notify.py) ---
# Отдельный инстанс под нотификации. Токен уходит в URL —
# это архитектура Green API, поэтому ротация раз в квартал.
GREEN_API_INSTANCE=
GREEN_API_TOKEN=
# Кому слать: 77001234567@c.us
GREEN_API_CHAT_ID=
